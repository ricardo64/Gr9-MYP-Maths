    // INTERACTION & VALIDATION LOGIC
    // ==========================================

    function selectMcq(qId, optionKey) {
      userState.mcq[qId] = optionKey;
      userState.attempted[qId] = true;

      // Update visual radio styling
      ['a', 'b', 'c', 'd'].forEach(k => {
        const lbl = document.getElementById(`opt-label-${qId}-${k}`);
        if (!lbl) return;
        const radio = lbl.querySelector('input[type="radio"]');
        if (k === optionKey) {
          radio.checked = true;
          lbl.classList.add('border-indigo-500', 'bg-indigo-50/80', 'ring-1', 'ring-indigo-500');
          lbl.classList.remove('border-slate-200', 'bg-slate-50/60');
        } else {
          radio.checked = false;
          lbl.classList.remove('border-indigo-500', 'bg-indigo-50/80', 'ring-1', 'ring-indigo-500', 'border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50');
          lbl.classList.add('border-slate-200', 'bg-slate-50/60');
        }
      });

      updateProgress();
    }

    function checkMcq(qId, silent = false) {
      const q = section1Data.find(item => item.id === qId);
      const selected = userState.mcq[qId];
      const feedbackEl = document.getElementById(`feedback-${qId}`);
      const statusEl = document.getElementById(`status-${qId}`);
      const cardEl = document.getElementById(`card-${qId}`);

      if (!selected) {
        if (!silent) showToast(`Please select an option (a, b, c, or d) for Question ${q.num} first.`);
        return false;
      }

      const isCorrect = selected === q.correct;
      userState.checked[qId] = isCorrect;
      userState.attempted[qId] = true;

      // Highlight options
      ['a', 'b', 'c', 'd'].forEach(k => {
        const lbl = document.getElementById(`opt-label-${qId}-${k}`);
        lbl.classList.remove('border-indigo-500', 'bg-indigo-50/80', 'ring-1', 'ring-indigo-500', 'border-emerald-500', 'bg-emerald-50', 'border-rose-500', 'bg-rose-50');
        if (k === q.correct) {
          lbl.classList.add('border-emerald-500', 'bg-emerald-50');
        } else if (k === selected && !isCorrect) {
          lbl.classList.add('border-rose-500', 'bg-rose-50');
        } else {
          lbl.classList.add('border-slate-200', 'bg-slate-50/60');
        }
      });

      statusEl.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800');
      feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-900', 'bg-rose-50', 'border-rose-200', 'text-rose-900');

      if (isCorrect) {
        statusEl.textContent = '✓ Correct';
        statusEl.classList.add('bg-emerald-100', 'text-emerald-800');
        cardEl.classList.remove('border-rose-300');
        cardEl.classList.add('border-emerald-300');
        feedbackEl.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
        feedbackEl.innerHTML = `<strong>Spot on!</strong> ${q.explanation}`;
      } else {
        statusEl.textContent = '✗ Review';
        statusEl.classList.add('bg-rose-100', 'text-rose-800');
        cardEl.classList.remove('border-emerald-300');
        cardEl.classList.add('border-rose-300');
        feedbackEl.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-900');
        feedbackEl.innerHTML = `<strong>Not quite.</strong> The correct choice is <strong>${q.correct.toUpperCase()}</strong>. ${q.explanation}`;
      }

      updateProgress();
      return isCorrect;
    }

    function normalizeEquation(raw) {
      if (!raw) return '';
      return raw
        .toLowerCase()
        .replace(/\s+/g, '')
        .replace(/€|\$/g, '')
        .replace(/−|–/g, '-')
        .replace(/×/g, '*')
        .replace(/÷/g, '/');
    }

    function extractNumber(raw) {
      if (!raw) return NaN;
      // Remove currency symbols and commas, match first valid decimal/negative number
      const cleaned = raw.replace(/€|\$|,/g, '').trim();
      const match = cleaned.match(/-?\d+(\.\d+)?/);
      return match ? parseFloat(match[0]) : NaN;
    }

    function onInputProgress(qId) {
      const v = document.getElementById(`var-${qId}`)?.value.trim();
      const e = document.getElementById(`eq-${qId}`)?.value.trim();
      const a = document.getElementById(`ans-${qId}`)?.value.trim();
      if (v || e || a) {
        userState.attempted[qId] = true;
      } else {
        delete userState.attempted[qId];
      }
      updateProgress();
    }

    function checkWordProblem(qId, isTwoStep, silent = false) {
      const dataset = isTwoStep ? section3Data : section2Data;
      const q = dataset.find(item => item.id === qId);

      const varVal = document.getElementById(`var-${qId}`).value.trim();
      const eqVal = document.getElementById(`eq-${qId}`).value.trim();
      const ansVal = document.getElementById(`ans-${qId}`).value.trim();

      const statusEl = document.getElementById(`status-${qId}`);
      const feedbackEl = document.getElementById(`feedback-${qId}`);
      const cardEl = document.getElementById(`card-${qId}`);
      const eqBadgeEl = document.getElementById(`eq-badge-${qId}`);

      if (!ansVal && !eqVal && !varVal) {
        if (!silent) showToast(`Fill in the steps for Question ${q.num} before checking.`);
        return false;
      }

      userState.attempted[qId] = true;

      // Validate equation flexibly
      const normUserEq = normalizeEquation(eqVal);
      // Also allow user to pick any single letter variable (e.g., n, c, p, m, b) instead of x
      let eqMatches = false;
      if (normUserEq.includes('=')) {
        const letterMatch = normUserEq.match(/[a-z]/);
        const userLetter = letterMatch ? letterMatch[0] : 'x';
        const swappedToX = normUserEq.replace(new RegExp(userLetter, 'g'), 'x');
        eqMatches = q.validEqs.includes(normUserEq) || q.validEqs.includes(swappedToX);
      }

      if (eqVal) {
        eqBadgeEl.classList.remove('hidden', 'text-emerald-600', 'text-amber-600');
        if (eqMatches) {
          eqBadgeEl.textContent = '✓ Valid equation';
          eqBadgeEl.classList.add('text-emerald-600');
        } else {
          eqBadgeEl.textContent = 'Check model equation below';
          eqBadgeEl.classList.add('text-amber-600');
        }
      }

      // Validate final numeric answer
      const userNum = extractNumber(ansVal);
      const isAnsCorrect = !isNaN(userNum) && Math.abs(userNum - q.numericAns) < 0.015;
      userState.checked[qId] = isAnsCorrect;

      statusEl.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800');
      feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-900', 'bg-rose-50', 'border-rose-200', 'text-rose-900');

      const varReminder = !varVal
        ? `<div class="text-amber-800 bg-amber-100/70 px-2.5 py-1 rounded-lg mt-1"><strong>Tip:</strong> Don't forget Step 1 — write down what your variable represents!</div>`
        : '';

      if (isAnsCorrect) {
        statusEl.textContent = '✓ Correct';
        statusEl.classList.add('bg-emerald-100', 'text-emerald-800');
        cardEl.classList.remove('border-rose-300');
        cardEl.classList.add('border-emerald-300');
        feedbackEl.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
        feedbackEl.innerHTML = `
          <div class="font-bold text-emerald-800">✓ Great work! Your final answer (${q.displayAns}) is correct.</div>
          <div><strong>Model Variable:</strong> ${q.modelVar}</div>
          <div><strong>Model Equation:</strong> <span class="font-math font-semibold">${q.modelEq}</span></div>
          <div><strong>Solution Steps:</strong> ${q.steps}</div>
          ${varReminder}
        `;
      } else {
        statusEl.textContent = '✗ Try Again';
        statusEl.classList.add('bg-rose-100', 'text-rose-800');
        cardEl.classList.remove('border-emerald-300');
        cardEl.classList.add('border-rose-300');
        feedbackEl.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-900');
        feedbackEl.innerHTML = `
          <div class="font-bold text-rose-800">✗ Not quite right yet. Compare your work with the model solution:</div>
          <div><strong>Model Variable:</strong> ${q.modelVar}</div>
          <div><strong>Model Equation:</strong> <span class="font-math font-semibold">${q.modelEq}</span></div>
          <div><strong>Solution Steps:</strong> ${q.steps}</div>
          <div><strong>Correct Final Answer:</strong> <span class="font-bold">${q.displayAns}</span></div>
          ${varReminder}
        `;
      }

      updateProgress();
      return isAnsCorrect;
    }

    function updateProgress() {
      const totalQuestions = 25;
      const attemptedCount = Object.keys(userState.attempted).length;
      const correctIds = Object.keys(userState.checked).filter(id => userState.checked[id]);
      const score = correctIds.length;

      document.getElementById('live-score').textContent = `${score} / ${totalQuestions}`;
      document.getElementById('progress-text').textContent = `${attemptedCount}/${totalQuestions} Answered`;
      const pct = Math.round((attemptedCount / totalQuestions) * 100);
      document.getElementById('progress-bar').style.width = `${pct}%`;

      // Section badges
      const s1Score = section1Data.filter(q => userState.checked[q.id]).length;
      const s2Score = section2Data.filter(q => userState.checked[q.id]).length;
      const s3Score = section3Data.filter(q => userState.checked[q.id]).length;

      document.getElementById('sec1-badge').textContent = `${s1Score} / 5 Correct`;
      document.getElementById('sec2-badge').textContent = `${s2Score} / 10 Correct`;
      document.getElementById('sec3-badge').textContent = `${s3Score} / 10 Correct`;
    }

    function gradeAll() {
      section1Data.forEach(q => {
        if (userState.mcq[q.id]) {
          checkMcq(q.id, true);
        } else {
          // Reveal unanswered feedback cleanly
          const feedbackEl = document.getElementById(`feedback-${q.id}`);
          const statusEl = document.getElementById(`status-${q.id}`);
          statusEl.textContent = 'Unanswered';
          statusEl.className = 'shrink-0 text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800';
          feedbackEl.className = 'mt-3 p-3.5 rounded-xl text-xs sm:text-sm border bg-amber-50 border-amber-200 text-amber-900';
          feedbackEl.innerHTML = `<strong>Unanswered.</strong> Correct choice: <strong>${q.correct.toUpperCase()}</strong>. ${q.explanation}`;
        }
      });

      const revealWordMissed = (q, isTwoStep) => {
        const v = document.getElementById(`var-${q.id}`).value.trim();
        const e = document.getElementById(`eq-${q.id}`).value.trim();
        const a = document.getElementById(`ans-${q.id}`).value.trim();
        if (v || e || a) {
          checkWordProblem(q.id, isTwoStep, true);
        } else {
          const feedbackEl = document.getElementById(`feedback-${q.id}`);
          const statusEl = document.getElementById(`status-${q.id}`);
          statusEl.textContent = 'Unanswered';
          statusEl.className = 'shrink-0 text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800';
          feedbackEl.className = 'mt-3.5 p-4 rounded-xl text-xs sm:text-sm border space-y-1 bg-amber-50 border-amber-200 text-amber-900';
          feedbackEl.innerHTML = `
            <div class="font-bold">Unanswered — Model Solution:</div>
            <div><strong>1. Variable:</strong> ${q.modelVar}</div>
            <div><strong>2. Equation:</strong> <span class="font-math font-semibold">${q.modelEq}</span></div>
            <div><strong>3. Steps:</strong> ${q.steps}</div>
            <div><strong>4. Answer:</strong> <span class="font-bold">${q.displayAns}</span></div>
          `;
        }
      };

      section2Data.forEach(q => revealWordMissed(q, false));
      section3Data.forEach(q => revealWordMissed(q, true));

      updateProgress();

      const score = Object.keys(userState.checked).filter(id => userState.checked[id]).length;
      const pct = Math.round((score / 25) * 100);
      const studentName = document.getElementById('student-name').value.trim() || 'Student';
      const rawDate = document.getElementById('assignment-date').value;
      const formattedDate = rawDate
        ? new Date(rawDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
        : new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const banner = document.getElementById('summary-banner');

      banner.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-400', 'text-emerald-950', 'bg-indigo-50', 'border-indigo-400', 'text-indigo-950');
      if (pct >= 80) {
        banner.classList.add('bg-emerald-50', 'border-emerald-400', 'text-emerald-950');
      } else {
        banner.classList.add('bg-indigo-50', 'border-indigo-400', 'text-indigo-950');
      }

      banner.innerHTML = `
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-slate-900 text-white">Assignment Submitted</span>
                <span class="text-xs font-semibold opacity-75">Date: ${escapeHtml(formattedDate)}</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-extrabold mt-1.5">${escapeHtml(studentName)} &mdash; Score: ${score} / 25 (${pct}%)</h3>
              <p class="text-xs sm:text-sm mt-1 opacity-90">
                Section 1 (MCQ): <strong>${section1Data.filter(q => userState.checked[q.id]).length}/5</strong> &bull;
                Section 2 (One-Step): <strong>${section2Data.filter(q => userState.checked[q.id]).length}/10</strong> &bull;
                Section 3 (Two-Step): <strong>${section3Data.filter(q => userState.checked[q.id]).length}/10</strong>
              </p>
            </div>
            <button onclick="window.print()" class="no-print px-4 py-2 rounded-xl bg-slate-900 text-white text-xs sm:text-sm font-bold hover:bg-slate-800 transition shrink-0">
              Print / Save Graded Sheet
            </button>
          </div>

          <div class="p-4 rounded-xl bg-white/95 border-2 border-amber-400 text-slate-900 flex items-start gap-3 shadow-xs">
            <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider text-amber-800">Next Step: Upload to Toddle</div>
              <p class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">
                Well done! Please take a screenshot of this top score banner and upload it to today&apos;s Toddle assignment.
              </p>
            </div>
          </div>
        </div>
      `;

      switchSection('all');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchSection(target) {
      const s1 = document.getElementById('section-1');
      const s2 = document.getElementById('section-2');
      const s3 = document.getElementById('section-3');

      s1.classList.toggle('hidden', target !== 'all' && target !== 'sec1');
      s2.classList.toggle('hidden', target !== 'all' && target !== 'sec2');
      s3.classList.toggle('hidden', target !== 'all' && target !== 'sec3');

      ['all', 'sec1', 'sec2', 'sec3'].forEach(tab => {
        const btn = document.getElementById(`tab-${tab}`);
        if (tab === target) {
          btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm', 'font-bold');
          btn.classList.remove('text-slate-600', 'hover:bg-slate-100', 'font-semibold');
        } else {
          btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm', 'font-bold');
          btn.classList.add('text-slate-600', 'hover:bg-slate-100', 'font-semibold');
        }
      });
    }

    function toggleGuide() {
      const guide = document.getElementById('strategy-guide');
      const chevron = document.getElementById('guide-chevron');
      const isHidden = guide.classList.contains('hidden');
      guide.classList.toggle('hidden');
      chevron.textContent = isHidden ? 'Hide Guide ▲' : 'Show Guide ▼';
    }

    function resetAssignment() {
      if (userState.teacherMode) {
        exitTeacherKeyMode();
      }
      userState.mcq = {};
      userState.checked = {};
      userState.attempted = {};
      document.getElementById('summary-banner').classList.add('hidden');
      renderSection1();
      renderWordSection(section2Data, 'sec2-container', false);
      renderWordSection(section3Data, 'sec3-container', true);
      updateProgress();
      showToast('All answers and inputs have been cleared.');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 3200);
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }
  </script>
</body>
</html>
