    function handleTeacherKeyToggle() {
      if (userState.teacherMode) {
        exitTeacherKeyMode();
      } else {
        openTeacherModal();
      }
    }

    function openTeacherModal() {
      const modal = document.getElementById('teacher-modal');
      const input = document.getElementById('teacher-pin-input');
      const errorEl = document.getElementById('teacher-pin-error');
      errorEl.classList.add('hidden');
      input.value = '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => input.focus(), 50);
    }

    function closeTeacherModal() {
      const modal = document.getElementById('teacher-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function verifyTeacherPin() {
      const input = document.getElementById('teacher-pin-input');
      const errorEl = document.getElementById('teacher-pin-error');
      if (input.value.trim() === TEACHER_PIN_HASH) {
        closeTeacherModal();
        enterTeacherKeyMode();
      } else {
        errorEl.classList.remove('hidden');
        input.value = '';
        input.focus();
      }
    }

