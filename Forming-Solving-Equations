        });
        const keyBox = document.getElementById(`teacher-key-${q.id}`);
        if (keyBox) keyBox.classList.remove('hidden');
      });

      // Reveal Section 2 & Section 3 Model Answer Keys without altering student input boxes
      [...section2Data, ...section3Data].forEach(q => {
        const keyBox = document.getElementById(`teacher-key-${q.id}`);
        if (keyBox) keyBox.classList.remove('hidden');
      });

      showToast('Teacher Answer Key unlocked.');
    }

    function exitTeacherKeyMode() {
      userState.teacherMode = false;

      // Restore header toggle button
      const btn = document.getElementById('teacher-key-btn');
      const label = document.getElementById('teacher-key-label');
      const icon = document.getElementById('teacher-key-icon');
      btn.className = 'no-print px-3 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs sm:text-sm font-semibold transition flex items-center gap-1.5';
      label.textContent = 'Teacher Answer Key';
      icon.className = 'w-4 h-4 text-amber-700';
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>';

      // Hide active banner
      document.getElementById('teacher-mode-banner').classList.add('hidden');

      // Hide all Teacher Key boxes & restore Section 1 option highlights to student state
      section1Data.forEach(q => {
        const keyBox = document.getElementById(`teacher-key-${q.id}`);
        if (keyBox) keyBox.classList.add('hidden');

        const selected = userState.mcq[q.id];
        const isChecked = Object.prototype.hasOwnProperty.call(userState.checked, q.id);
        ['a', 'b', 'c', 'd'].forEach(k => {
          const lbl = document.getElementById(`opt-label-${q.id}-${k}`);
          if (!lbl) return;
          lbl.classList.remove('border-emerald-500', 'bg-emerald-50', 'ring-1', 'ring-emerald-500', 'teacher-highlight', 'border-indigo-500', 'bg-indigo-50/80', 'ring-indigo-500', 'border-rose-500', 'bg-rose-50');
          lbl.classList.add('border-slate-200', 'bg-slate-50/60');
          if (isChecked) {
