      label.textContent = 'Exit Answer Key (Student View)';
      icon.className = 'w-4 h-4 text-white';
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>';

      // Show active banner
      document.getElementById('teacher-mode-banner').classList.remove('hidden');

      // Reveal Section 1 MCQ Answer Key
      section1Data.forEach(q => {
        ['a', 'b', 'c', 'd'].forEach(k => {
          const lbl = document.getElementById(`opt-label-${q.id}-${k}`);
          if (!lbl) return;
          if (k === q.correct) {
            lbl.classList.add('border-emerald-500', 'bg-emerald-50', 'ring-1', 'ring-emerald-500', 'teacher-highlight');
