<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grade 9 Math: Forming and Solving Equations</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
      scroll-behavior: smooth;
    }
    .font-math {
      font-family: 'JetBrains Mono', monospace;
    }
    /* Stacked Fraction Styling */
    .frac {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      vertical-align: middle;
      line-height: 1.05;
      margin: 0 3px;
      font-size: 0.92em;
    }
    .frac > span:first-child {
      border-bottom: 1.5px solid currentColor;
      padding: 0 4px 1px 4px;
    }
    .frac > span:last-child {
      padding: 1px 4px 0 4px;
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @media print {
      @page {
        size: auto;
        margin: 12mm 12mm 14mm 12mm;
      }

      /* Strict Monochrome / Greyscale Enforcement */
      html, body {
        background: #ffffff !important;
        color: #000000 !important;
        filter: grayscale(100%) !important;
        -webkit-filter: grayscale(100%) !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        font-size: 10.5pt !important;
      }

      *, *::before, *::after {
        box-shadow: none !important;
        text-shadow: none !important;
        background-image: none !important;
      }

      /* Hide interactive UI chrome */
      .no-print,
      header button,
      nav,
      footer,
      #toast,
      #strategy-guide,
      #teacher-modal {
        display: none !important;
      }

      /* Flatten sticky header into a clean worksheet title banner */
      header {
        position: static !important;
        background: #ffffff !important;
        border: 1.5px solid #000000 !important;
        border-radius: 0 !important;
        margin-bottom: 10px !important;
        padding: 8px 12px !important;
      }

      header .bg-indigo-600 {
        background: #111111 !important;
        color: #ffffff !important;
        border-radius: 4px !important;
      }

      header .bg-indigo-50,
      header .bg-slate-100 {
        background: #f3f4f6 !important;
        color: #000000 !important;
        border: 1px solid #374151 !important;
      }

      header .text-indigo-700,
      header .text-slate-500,
      header .text-slate-900 {
        color: #000000 !important;
      }

      /* Hide progress bar track in print */
      header > div > div:last-child {
        display: none !important;
      }

      main {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      /* Student Name & Date Box */
      main > section:first-of-type {
        background: #ffffff !important;
        border: 1.5px solid #222222 !important;
        border-radius: 0 !important;
        padding: 10px 12px !important;
        margin-bottom: 14px !important;
      }

      main > section:first-of-type > div:last-child {
        display: none !important;
      }

      #student-name,
      #assignment-date {
        border: 1px solid #333333 !important;
        border-radius: 0 !important;
        background: #ffffff !important;
        color: #000000 !important;
      }

      /* Ensure all 3 sections print & force explicit page breaks between sections */
      .section-panel {
        display: block !important;
        padding-top: 0 !important;
      }

      #section-2,
      #section-3 {
        page-break-before: always !important;
        break-before: page !important;
      }

      /* Section Header Styling in Monochrome */
      .section-panel > div:first-child {
        border-bottom: 2px solid #000000 !important;
        padding-bottom: 6px !important;
        margin-bottom: 12px !important;
      }

      .section-panel span,
      .section-panel h2,
      .section-panel p {
        color: #000000 !important;
      }

      #sec1-badge,
      #sec2-badge,
      #sec3-badge {
        background: #f3f4f6 !important;
        color: #000000 !important;
        border: 1px solid #374151 !important;
        border-radius: 2px !important;
      }

      /* Worksheet-Style 2-Column Grid for Section 1 (MCQ) */
      #sec1-container {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important;
      }

      #sec1-container > .question-card:last-child {
        grid-column: span 2 / span 2 !important;
      }

      /* Worksheet-Style 2-Column Grid for Sections 2 & 3 (Word Problems) */
      #sec2-container,
      #sec3-container {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important;
      }

      /* Crisp Worksheet Borders & Prevent Splitting Across Pages */
      .question-card {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        background: #ffffff !important;
        border: 1.5px solid #222222 !important;
        border-radius: 0 !important;
        padding: 10px !important;
        margin: 0 !important;
      }

      /* Question Number Badges */
      .question-card .w-7.h-7 {
        background: #e5e7eb !important;
        color: #000000 !important;
        border: 1px solid #222222 !important;
        border-radius: 2px !important;
      }

      /* MCQ Option Boxes */
      #sec1-container label {
        background: #ffffff !important;
        border: 1px solid #4b5563 !important;
        border-radius: 0 !important;
        padding: 6px 8px !important;
        color: #000000 !important;
      }

      /* Step Containers inside Word Problems */
      .question-card .space-y-3 {
        gap: 6px !important;
      }

      .question-card .space-y-3 > div {
        background: #f9fafb !important;
        border: 1px solid #9ca3af !important;
        border-radius: 0 !important;
        padding: 6px 8px !important;
        margin-top: 6px !important;
      }

      .question-card .space-y-3 > div:first-child {
        margin-top: 0 !important;
      }

      /* Step Circle Badges */
      .question-card .w-5.h-5 {
        background: #e5e7eb !important;
        color: #000000 !important;
        border: 1px solid #374151 !important;
      }

      /* Clear Rectangular Worksheet Answer & Working Boxes */
      .question-card input[type="text"],
      .question-card textarea {
        background: #ffffff !important;
        border: 1px solid #333333 !important;
        border-radius: 0 !important;
        color: #000000 !important;
        min-height: 28px !important;
        padding: 4px 6px !important;
        width: 100% !important;
      }

      .question-card textarea {
        min-height: 44px !important;
      }

      /* Hide placeholders when printing blank so students have clean white boxes to write in */
      .question-card input::placeholder,
      .question-card textarea::placeholder {
        color: transparent !important;
      }

      /* Monochrome Feedback / Summary Banners if already revealed */
      #summary-banner,
      #teacher-mode-banner,
      .teacher-key-box,
      [id^="feedback-"] {
        background: #f3f4f6 !important;
        border: 1px solid #222222 !important;
        border-radius: 0 !important;
        color: #000000 !important;
      }

      [id^="status-"],
      [id^="eq-badge-"] {
        background: #e5e7eb !important;
        color: #000000 !important;
        border: 1px solid #374151 !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- Sticky Top Academic Header -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <!-- Title & Badge -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-lg shadow-sm shrink-0">
            ∑x
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">Grade 9 Algebra</span>
              <span class="text-xs font-medium text-slate-500">Currency: Euros (€)</span>
            </div>
            <h1 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight">Forming &amp; Solving Equations</h1>
          </div>
        </div>

        <!-- Score & Action Buttons -->
        <div class="flex items-center justify-between md:justify-end gap-2 sm:gap-3 flex-wrap">
          <div class="flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">
            <span class="text-xs font-semibold text-slate-500 uppercase">Score</span>
            <span id="live-score" class="text-sm sm:text-base font-extrabold text-indigo-700">0 / 25</span>
          </div>

          <button onclick="gradeAll()" class="no-print px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white text-xs sm:text-sm font-semibold shadow-sm transition flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Submit Assignment</span>
          </button>

          <button id="teacher-key-btn" onclick="handleTeacherKeyToggle()" class="no-print px-3 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs sm:text-sm font-semibold transition flex items-center gap-1.5" title="Switch to Teacher Answer Key View">
            <svg id="teacher-key-icon" class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span id="teacher-key-label">Teacher Answer Key</span>
          </button>

          <button onclick="window.print()" class="no-print px-3 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 text-xs sm:text-sm font-semibold transition flex items-center gap-1.5" title="Print or Save as PDF">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span class="hidden sm:inline">Print / PDF</span>
          </button>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="mt-2.5 flex items-center gap-3">
        <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
          <div id="progress-bar" class="bg-indigo-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <span id="progress-text" class="text-xs font-semibold text-slate-500 whitespace-nowrap">0/25 Answered</span>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 flex-1 space-y-6">

    <!-- Top Toddle Submission & Score Banner (Revealed on Submit Assignment) -->
    <div id="summary-banner" class="hidden rounded-2xl p-5 sm:p-6 border-2 shadow-md transition-all"></div>

    <!-- Student Details & Quick Strategy Guide -->
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label for="student-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Student Full Name</label>
          <input id="student-name" type="text" placeholder="Enter your name..." class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
        </div>
        <div>
          <label for="assignment-date" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Date</label>
          <input id="assignment-date" type="date" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
        </div>
      </div>

      <!-- Collapsible Grade 9 Tip Box -->
      <div class="border-t border-slate-100 pt-3">
        <button type="button" onclick="toggleGuide()" class="no-print w-full flex items-center justify-between text-left px-3.5 py-2.5 rounded-xl bg-indigo-50/70 hover:bg-indigo-50 text-indigo-900 border border-indigo-100 transition">
          <span class="flex items-center gap-2 text-sm font-bold">
            <span class="w-6 h-6 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs">?</span>
            Quick Guide: How to Form &amp; Solve Word Problem Equations
          </span>
          <span id="guide-chevron" class="text-xs font-semibold text-indigo-700">Show Guide ▼</span>
        </button>

        <div id="strategy-guide" class="hidden mt-3 grid grid-cols-1 md:grid-cols-4 gap-3 text-xs sm:text-sm">
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-indigo-700 mb-1">1. Name a Variable</div>
            <p class="text-slate-600">Identify what the question asks you to find and assign a letter, e.g., <code class="font-math bg-white px-1.5 py-0.5 rounded border">Let x = cost of 1 pencil (€)</code>.</p>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-indigo-700 mb-1">2. Translate Keywords</div>
            <p class="text-slate-600"><em>"Total / sum / more"</em> → <code class="font-math">+</code><br/><em>"Difference / left / reduced"</em> → <code class="font-math">-</code><br/><em>"Each / times / per"</em> → <code class="font-math">×</code><br/><em>"Split / shared / half"</em> → <code class="font-math">÷</code></p>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-indigo-700 mb-1">3. Inverse Operations</div>
            <p class="text-slate-600">For two-step equations, undo <strong>addition or subtraction</strong> first, then undo <strong>multiplication or division</strong> on both sides.</p>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="font-bold text-indigo-700 mb-1">4. Check &amp; Label Units</div>
            <p class="text-slate-600">Substitute your answer back into the story to verify it makes sense, and include units like <code class="font-math">€</code> or <code class="font-math">students</code>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Navigation Tabs -->
    <nav class="no-print flex flex-wrap items-center justify-between gap-2 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
      <div class="flex flex-wrap gap-1.5 w-full sm:w-auto">
        <button onclick="switchSection('all')" id="tab-all" class="tab-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 text-white shadow-sm transition">
          All Sections (25)
        </button>
        <button onclick="switchSection('sec1')" id="tab-sec1" class="tab-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
          1. Multiple Choice (5)
        </button>
        <button onclick="switchSection('sec2')" id="tab-sec2" class="tab-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
          2. One-Step Problems (10)
        </button>
        <button onclick="switchSection('sec3')" id="tab-sec3" class="tab-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
          3. Two-Step Problems (10)
        </button>
      </div>
      <button onclick="resetAssignment()" class="px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition ml-auto">
        Reset All
      </button>
    </nav>

    <!-- Teacher Answer Key Active Banner -->
    <div id="teacher-mode-banner" class="hidden rounded-2xl p-4 sm:p-5 bg-amber-50 border-2 border-amber-400 text-amber-950 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-start sm:items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        </div>
        <div>
          <div class="text-xs font-extrabold uppercase tracking-wider text-amber-800">Teacher Answer Key Mode Active</div>
          <p class="text-xs sm:text-sm text-amber-900">All correct options, model equations, step-by-step workings, and Euro (&euro;) solutions are displayed below without altering student entries.</p>
        </div>
      </div>
      <button type="button" onclick="exitTeacherKeyMode()" class="no-print px-4 py-2 rounded-xl bg-amber-900 hover:bg-amber-950 text-white text-xs sm:text-sm font-bold transition shrink-0">
        Exit Answer Key (Student View)
      </button>
    </div>

    <!-- ========================================================= -->
    <section id="section-1" class="section-panel space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Section 1 of 3</span>
          <h2 class="text-xl font-extrabold text-slate-900">Two-Step Equations — Multiple Choice</h2>
          <p class="text-sm text-slate-600">Select the equation that accurately models each real-world scenario.</p>
        </div>
        <span id="sec1-badge" class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0 / 5 Correct</span>
      </div>

      <div id="sec1-container" class="space-y-4"></div>
    </section>

    <!-- ========================================================= -->
    <!-- SECTION 2: ONE-STEP WORD PROBLEMS (10 QUESTIONS)          -->
    <!-- ========================================================= -->
    <section id="section-2" class="section-panel space-y-4 pt-2">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Section 2 of 3</span>
          <h2 class="text-xl font-extrabold text-slate-900">One-Step Equation Word Problems</h2>
          <p class="text-sm text-slate-600">Follow the 3 guided steps: name your variable, write a one-step equation, and solve for the final answer.</p>
        </div>
        <span id="sec2-badge" class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0 / 10 Correct</span>
      </div>

      <div id="sec2-container" class="space-y-5"></div>
    </section>

    <!-- ========================================================= -->
    <!-- SECTION 3: TWO-STEP WORD PROBLEMS (10 QUESTIONS)          -->
    <!-- ========================================================= -->
    <section id="section-3" class="section-panel space-y-4 pt-2">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Section 3 of 3</span>
          <h2 class="text-xl font-extrabold text-slate-900">Two-Step Equation Word Problems</h2>
          <p class="text-sm text-slate-600">Name your variable, form the two-step equation, show your inverse operation steps, and enter your final answer.</p>
        </div>
        <span id="sec3-badge" class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0 / 10 Correct</span>
      </div>

      <div id="sec3-container" class="space-y-5"></div>
    </section>

    <!-- Bottom Submit Bar -->
    <div class="no-print bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h3 class="font-bold text-slate-900">Finished your assignment?</h3>
        <p class="text-xs sm:text-sm text-slate-500">Click below to submit all 25 questions, view your final score at the top, and get your Toddle upload instructions.</p>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto justify-center">
        <button onclick="gradeAll()" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-sm transition flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Submit Assignment</span>
        </button>
      </div>
    </div>

  </main>

  <footer class="border-t border-slate-200 bg-white py-4 mt-8 text-center text-xs text-slate-400">
    Grade 9 Mathematics &bull; Forming and Solving Equations Interactive Worksheet
  </footer>

  <!-- Custom Notification Toast (Replaces alert) -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden max-w-sm bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg text-sm font-medium transition-opacity"></div>

  <!-- Teacher Password Modal -->
  <div id="teacher-modal" class="no-print fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4" onclick="if(event.target===this) closeTeacherModal()">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xl max-w-sm w-full p-6 space-y-4">
